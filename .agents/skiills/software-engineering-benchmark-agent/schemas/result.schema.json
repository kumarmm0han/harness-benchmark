{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SoftwareEngineeringBenchmarkResult",
  "type": "object",
  "required": ["candidate_id", "scores", "total", "summary"],
  "properties": {
    "candidate_id": {"type": "string"},
    "scores": {
      "type": "object",
      "properties": {
        "functional_correctness": {"type": "number", "minimum": 0, "maximum": 25},
        "requirement_adherence": {"type": "number", "minimum": 0, "maximum": 15},
        "guardrail_adherence": {"type": "number", "minimum": 0, "maximum": 15},
        "architecture_quality": {"type": "number", "minimum": 0, "maximum": 10},
        "technical_design_quality": {"type": "number", "minimum": 0, "maximum": 10},
        "task_decomposition": {"type": "number", "minimum": 0, "maximum": 5},
        "simplicity": {"type": "number", "minimum": 0, "maximum": 10},
        "test_quality": {"type": "number", "minimum": 0, "maximum": 5},
        "design_to_code_consistency": {"type": "number", "minimum": 0, "maximum": 5}
      },
      "additionalProperties": false
    },
    "total": {"type": "number", "minimum": 0, "maximum": 100},
    "requirement_coverage": {"type": "object"},
    "guardrail_violations": {"type": "array", "items": {"type": "string"}},
    "design_drift": {"type": "array", "items": {"type": "string"}},
    "efficiency": {"type": "object"},
    "summary": {"type": "string"}
  },
  "additionalProperties": true
}
